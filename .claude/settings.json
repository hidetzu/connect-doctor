{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/ask-slack.mjs",
            "timeout": 200
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "T=$(cat .flagman/task 2>/dev/null); PATH=\"$PATH:$HOME/go/bin\" flagman hook claude-code ${T:+--task \"$T\"}",
            "timeout": 60,
            "statusMessage": "flagman: should the AI go on alone?"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/telemetry.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/telemetry.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
